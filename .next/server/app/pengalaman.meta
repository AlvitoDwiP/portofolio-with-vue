{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/pengalaman/layout,_N_T_/pengalaman/page,_N_T_/pengalaman"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/pengalaman/__PAGE__",
    "/pengalaman",
    "/_index",
    "/_head"
  ]
}